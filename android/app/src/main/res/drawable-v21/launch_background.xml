<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen paints the app's own ink, not white. A white flash before a
  dark-themed app is the most visible rough edge a user meets, and it happens
  before a single line of Dart has run.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
