<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 și mai nou. Aceleași fișiere, două scenarii:
  cloud-backup   = backup în contul Google, pentru un telefon pierdut
  device-transfer = mutarea directă pe un telefon nou
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/tally.sqlite" />
        <include domain="root" path="app_flutter/backups" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/tally.sqlite" />
        <include domain="root" path="app_flutter/backups" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
